<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the very first frame: no white flash on start, splash or between screens. -->
    <style name="Theme.StarCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0B10</item>
        <item name="android:statusBarColor">#0A0B10</item>
        <item name="android:navigationBarColor">#0A0B10</item>
        <item name="android:windowSplashScreenBackground">#0A0B10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
