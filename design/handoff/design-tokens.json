      "accentGlow": "rgba(127,180,255,0.35)",
      "primaryFill": "#24426F",
      "primaryBorder": "rgba(127,180,255,0.55)",
      "primaryText": "#E3EEFF",
      "switchTrackOn": "#2E5591",
      "switchKnobOn": "#E3EEFF",
      "switchTrackOff": "#232736",
      "switchKnobOff": "#8891A5",
      "sliderTrack": "#232736",
      "warning": "#FFC66E",
      "warningFill": "rgba(255,198,110,0.10)",
