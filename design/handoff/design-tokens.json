{
  "meta": {
    "name": "StarCam",
    "units": "All sizes are dp (font sizes sp). Frames are 390 x 866 dp = 1080 x 2400 px at 2.77x.",
    "theme": "Dark only, plus a red night-vision variant of every screen."
  },
  "color": {
    "dark": {
      "background": "#0A0B10",
      "surface": "#12141C",
      "surfaceRaised": "#1A1D28",
