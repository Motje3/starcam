    "nightVision": {
      "background": "#120404",
      "surface": "#1C0807",
      "surfaceSunken": "#170606",
      "hairline": "rgba(255,85,68,0.18)",
      "text": "#FF5544",
      "text2": "#D9483A",
      "accent": "#FF5544",
      "selectedFill": "rgba(255,85,68,0.16)",
      "selectedBorder": "rgba(255,85,68,0.50)",
      "switchTrackOn": "#7A1C12",
      "switchKnobOn": "#FF5544",
      "sliderTrack": "#3A0F0B",
      "shutterDisk": "radial-gradient(#C2392B 0%, #8E2418 65%, #6A170E 100%)",
      "imageTreatment": "Render images grayscale, then multiply with #FF3B2A. No blue, white or grey anywhere."
    }
  },
  "font": {
    "ui": "Geist",
    "numeric": "Geist Mono",
    "rule": "Tabular figures for every number (exposure, ISO, timers, counts)."
  },
  "type": {
    "display":   {"font": "numeric", "size": 76, "weight": 300, "letterSpacing": "-0.03em", "use": "Frame counter 7 / 20"},
    "countdown": {"font": "numeric", "size": 92, "weight": 300, "use": "Hold-still countdown"},
    "readout":   {"font": "numeric", "size": 36, "weight": 400, "use": "Exposure ring 14.0"},
    "stat":      {"font": "numeric", "size": 26, "weight": 400, "use": "Time left, percent"},
    "title":     {"font": "ui", "size": 30, "weight": 600, "letterSpacing": "-0.02em", "use": "Session step titles"},
    "titleSmall":{"font": "ui", "size": 26, "weight": 600, "letterSpacing": "-0.02em"},
    "screenTitle":{"font": "ui", "size": 22, "weight": 600},
    "headline":  {"font": "ui", "size": 18, "weight": 600},
    "body":      {"font": "ui", "size": 15, "weight": 400, "lineHeight": 1.5},
    "bodySmall": {"font": "ui", "size": 13, "weight": 400, "lineHeight": 1.45},
    "button":    {"font": "ui", "size": 16, "weight": 600},
    "label":     {"font": "ui", "size": 12, "weight": 600, "letterSpacing": "0.08em", "case": "uppercase"},
    "caption":   {"font": "ui", "size": 12, "weight": 400},
    "data":      {"font": "numeric", "size": 12, "weight": 400, "use": "stars 312 · FWHM 1.6 px · drift 0.4 px"}
  },
  "space": [4, 8, 12, 16, 20, 24, 32],
  "screenMargin": 14,
  "radius": {"chip": 14, "button": 18, "segmentItem": 11, "card": 22, "sheet": 28, "pill": 999},
  "size": {
    "touchTargetMin": 44,
    "control": 56,
    "modeSwitch": 66,
    "segmented": 48,
    "shutter": 84,
    "shutterInner": 66,
    "sideButton": 52,
    "switch": [48, 28],
    "sliderKnob": 24,
    "icon": 24,
    "iconStroke": 1.75
  },
  "elevation": {
    "primaryButton": "0 8 24 rgba(40,90,170,0.25)",
    "sheet": "0 -24 48 rgba(0,0,0,0.55)",
    "accentGlow": "0 0 28 rgba(127,180,255,0.35)"
  }
}
